      { "label": "Mis cuentas", "icon": "receipt", "action": { "type": "navigate", "route": "/accounts" } }
    ] } },
    { "id": "tip", "type": "insight_card", "props": { "title": "¿Sabías que?", "text": "Puedes transferir entre tus cuentas al instante y sin costo." } }
  ]
}
