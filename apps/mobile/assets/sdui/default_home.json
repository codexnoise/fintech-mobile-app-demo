{
  "schemaVersion": 1,
  "screen": "home",
  "segment": "default",
  "version": "bundled-1",
  "ttlSeconds": 60,
  "components": [
    { "id": "greeting", "type": "greeting_header", "props": { "title": "Hola 👋", "subtitle": "Tu dinero, simple y a la mano" } },
    { "id": "balance", "type": "balance_summary", "props": { "source": "accounts", "showAccounts": true } },
    { "id": "actions", "type": "quick_actions", "props": { "actions": [
