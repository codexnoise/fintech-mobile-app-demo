{
  "schemaVersion": 1,
  "screen": "home",
  "segment": "entrepreneur",
  "version": "2026-10-04.1",
  "ttlSeconds": 300,
  "components": [
    { "id": "greeting", "type": "greeting_header", "props": { "title": "Hola, {{firstName}}", "subtitle": "Así va tu negocio hoy" } },
