    { "id": "actions", "type": "quick_actions", "props": { "actions": [
      { "label": "Transferir", "icon": "swap_horiz", "action": { "type": "navigate", "route": "/transfers/new" } },
      { "label": "Flujo de caja", "icon": "insights", "action": { "type": "open_assistant", "promptId": "spending_breakdown" } },
      { "label": "Seguro de viaje", "icon": "flight", "action": { "type": "open_micro_app", "appId": "travel_insurance" } }
    ] } },
    { "id": "insight", "type": "insight_card", "props": { "title": "Flujo del mes", "text": "Este mes tus egresos fueron {{spent}}. {{insight}}" } },
    { "id": "promo-credit", "type": "promo_banner", "props": {
      "title": "Capital de trabajo",
      "body": "Simula un crédito para tu negocio con tasa preferencial.",
      "cta": "Ver opciones",
      "tone": "neutral",
      "action": { "type": "open_assistant", "promptId": "savings_tips" } } }
  ]
}
