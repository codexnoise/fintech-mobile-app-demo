{
  "schemaVersion": 1,
  "screen": "home",
  "segment": "young_digital",
  "version": "2026-10-04.1",
  "ttlSeconds": 300,
  "components": [
    { "id": "greeting", "type": "greeting_header", "props": { "title": "Hola, {{firstName}} 👋", "subtitle": "Tu dinero, simple y a la mano" } },
    { "id": "balance", "type": "balance_summary", "props": { "source": "accounts", "showAccounts": true } },
    { "id": "actions", "type": "quick_actions", "props": { "actions": [
      { "label": "Transferir", "icon": "swap_horiz", "action": { "type": "navigate", "route": "/transfers/new" } },
      { "label": "Seguro de viaje", "icon": "flight", "action": { "type": "open_micro_app", "appId": "travel_insurance" } },
      { "label": "Asistente", "icon": "auto_awesome", "action": { "type": "open_assistant", "promptId": "monthly_summary" } }
    ] } },
    { "id": "insight", "type": "insight_card", "props": { "title": "Tus hábitos", "text": "{{insight}}" } },
    { "id": "promo-travel", "type": "promo_banner", "props": {
      "title": "¿Viaje en vacaciones?",
      "body": "Cotiza tu seguro de viaje en 1 minuto, 100% digital.",
      "cta": "Cotizar",
      "tone": "brand",
      "action": { "type": "open_micro_app", "appId": "travel_insurance" } } }
  ]
}
