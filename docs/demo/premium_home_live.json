{
  "schemaVersion": 1,
  "screen": "home",
  "segment": "premium",
  "version": "2026-10-05.live",
  "ttlSeconds": 300,
  "components": [
    {
      "id": "greeting",
      "type": "greeting_header",
      "props": {
        "title": "Buenas, {{firstName}}",
        "subtitle": "Novedad publicada en vivo desde el servidor"
      }
    },
    {
      "id": "promo-invest",
      "type": "promo_banner",
      "props": {
        "title": "Plazo fijo 7,5 % anual",
        "body": "Oferta exclusiva Premium: haz crecer tus {{saved}} ahorrados este mes.",
        "cta": "Simular inversión",
        "tone": "premium",
        "action": {
          "type": "open_assistant",
          "promptId": "savings_tips"
        }
      }
    },
    {
      "id": "balance",
      "type": "balance_summary",
      "props": {
        "source": "accounts",
        "showAccounts": true,
        "emphasis": "total"
      }
    },
    {
      "id": "actions",
      "type": "quick_actions",
      "props": {
        "actions": [
          {
            "label": "Transferir",
            "icon": "swap_horiz",
            "action": {
              "type": "navigate",
              "route": "/transfers/new"
            }
          },
          {
            "label": "Asesor IA",
            "icon": "auto_awesome",
            "action": {
              "type": "open_assistant",
              "promptId": "monthly_summary"
            }
          },
          {
            "label": "Seguro de viaje",
            "icon": "flight",
            "action": {
              "type": "open_micro_app",
              "appId": "travel_insurance"
            }
          }
        ]
      }
    },
    {
      "id": "travel",
      "type": "micro_app_tile",
      "props": {
        "title": "Seguro de viaje Premium",
        "body": "Cobertura internacional para ti y tu familia.",
        "action": {
          "type": "open_micro_app",
          "appId": "travel_insurance"
        }
      }
    },
    {
      "id": "insight",
      "type": "insight_card",
      "props": {
        "title": "Resumen",
        "text": "{{insight}}"
      }
    }
  ]
}